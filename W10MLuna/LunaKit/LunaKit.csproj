<?xml version="1.0" encoding="utf-8"?>
<!-- LunaKit: a Windows Runtime Component, because a WebView only exposes [AllowForWeb]
     objects from one (Bridge.cs). Its public surface is LunaCard and LunaHostBridge; the rest
     is internal. -->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">ARM</Platform>
    <ProjectGuid>{252F139E-E012-436D-B534-92FBF36DAC7E}</ProjectGuid>
    <OutputType>winmdobj</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>LunaKit</RootNamespace>
    <AssemblyName>LunaKit</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <!-- Windows 10 Mobile's last build, 15254, takes nothing newer than 15063 as a minimum. -->
    <TargetPlatformVersion>10.0.16299.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.15063.0</TargetPlatformMinVersion>
    <MinimumVisualStudioVersion>14</MinimumVisualStudioVersion>
    <FileAlignment>512</FileAlignment>
    <ProjectTypeGuids>{A5A43C5B-DE2A-4C0C-9213-0A381AF9435A};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <AllowCrossPlatformRetargeting>false</AllowCrossPlatformRetargeting>
    <LangVersion>7.3</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'ARM'">
    <PlatformTarget>ARM</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AppServer.cs" />
    <Compile Include="Apps.cs" />
    <Compile Include="Bridge.cs" />
    <Compile Include="Bus.cs" />
    <Compile Include="DeviceProfile.cs" />
    <Compile Include="FixedViewport.cs" />
    <Compile Include="Json.cs" />
    <Compile Include="Log.cs" />
    <Compile Include="LunaShell.cs" />
    <Compile Include="LunacyService.cs" />
    <Compile Include="Jx.cs" />
    <Compile Include="Db8.cs" />
    <Compile Include="Configurator.cs" />
    <Compile Include="SystemService.cs" />
    <Compile Include="WebosFs.cs" />
    <Compile Include="JsServices.cs" />
    <Compile Include="Crypto.cs" />
    <Compile Include="ActivityManager.cs" />
    <Compile Include="NetShim.cs" />
    <Compile Include="Services.cs" />
    <Compile Include="Sqlite.cs" />
    <Compile Include="Transforms.cs" />
    <Compile Include="WebSql.cs" />
    <Compile Include="UserFiles.cs" />
    <Compile Include="MediaFiles.cs" />
    <Compile Include="MediaIndex.cs" />
    <Compile Include="RadioServices.cs" />
    <Compile Include="Images.cs" />
    <Compile Include="Background.cs" />
    <Compile Include="WindowsNotifications.cs" />
    <Compile Include="Services2.cs" />
    <Compile Include="Services3.cs" />
    <Compile Include="AppManager.cs" />
    <Compile Include="WindowsAccount.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copied into each port's webos/lunacy/ by assemble-assets.ps1, beside the shared scripts. -->
    <None Include="JS\w10m-native.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform">
      <Version>6.2.14</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- StatusBar: the phone's own bar, which Luna's stood in for. -->
    <SDKReference Include="WindowsMobile, Version=10.0.15063.0">
      <Name>Windows Mobile Extensions for the UWP</Name>
    </SDKReference>
  </ItemGroup>
  <PropertyGroup Condition=" '$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '14.0' ">
    <VisualStudioVersion>14.0</VisualStudioVersion>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
</Project>
